# NxtPak AI — Environment Variables
DEBUG=false
ENVIRONMENT=development

# Database
DATABASE_URL=sqlite+aiosqlite:///./nxtpak.db

# Geometry Engine: trimesh (preferred) or numpy_only
GEOMETRY_ENGINE=trimesh

# Defaults
DEFAULT_CLEARANCE_MM=20.0
DEFAULT_BOARD_THICKNESS_MM=4.0
DEFAULT_INSERT_THICKNESS_MM=25.0

# Optional LLM
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

# CORS
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
