# NxtPak AI — Environment Variables
DEBUG=false
ENVIRONMENT=production

# Database (Ships empty by default)
DATABASE_URL=sqlite:///./nxtpak.db

# Geometry Engine: trimesh (preferred) or numpy_only
GEOMETRY_ENGINE=trimesh

# Engineering Defaults
DEFAULT_CLEARANCE_MM=15.0
DEFAULT_BOARD_THICKNESS_MM=5.0
DEFAULT_BOARD_COST_PER_M2=18.5
DEFAULT_CURRENCY=EGP

# Optional LLM Configuration (Configurable here or via the Settings UI)
# Supported providers: anthropic, gemini, openai
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=claude-3-5-sonnet-20241022

# CORS
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
